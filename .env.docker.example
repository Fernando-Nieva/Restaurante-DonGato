# Configuración de DEMO para Docker.
# Copiar con: cp .env.docker.example .env
# Las claves de este archivo son de DEMO y deben cambiarse antes de publicar en internet.

APP_NAME="Don Gato"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:ujbFN7zmJ8UabhBFCzodR7cizadob+0kNLnaequ6doU=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/sqlite/database.sqlite
CACHE_STORE=database
SESSION_DRIVER=database
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single

# Claves de DEMO para Reverb. Cambiar si se publica en internet.
REVERB_APP_ID=demo-app-id
REVERB_APP_KEY=demo-key
REVERB_APP_SECRET=demo-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Variables del navegador (se aplican al construir el frontend).
VITE_API_URL=http://localhost:8000
VITE_REVERB_APP_KEY=demo-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
