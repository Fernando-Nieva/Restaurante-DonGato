.git
.gitignore
**/.git
**/.env
**/.env.*
!**/.env.example
!**/.env.docker.example

**/node_modules
**/vendor
**/dist
**/*.sqlite
**/*.sqlite3

**/storage/logs/*
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/bootstrap/cache/*.php

**/.phpunit.result.cache
**/.phpunit.cache
**/.DS_Store
**/Thumbs.db
